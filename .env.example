# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Used by the harvester and tests (host side)
DATABASE_URL=postgresql://iris:change-me-locally@localhost:5432/iris
TEST_DATABASE_URL=postgresql://iris:change-me-locally@localhost:5432/iris

# Live source (verify with: iris-harvester check-source)
IRIS_FEED_URL=https://www.absolut-report.de/feed/
# Contact shown in the User-Agent so the publisher can reach the operator
IRIS_CONTACT=you@example.com
IRIS_MAX_PAGES=5
IRIS_PAGE_DELAY_S=1.0
IRIS_TIMEOUT_S=20
IRIS_MAX_RETRIES=3
IRIS_BACKOFF_FACTOR=1.0
# Optional overrides for the domain filter / gazetteer
# IRIS_TAXONOMY_PATH=./my_taxonomy.yaml
# IRIS_GAZETTEER_PATH=./gazetteer_de.csv
# IRIS_INSTITUTIONS_PATH=./institutions_de.csv
